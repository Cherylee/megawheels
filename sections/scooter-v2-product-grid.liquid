{%- comment -%}
  Scooter V2 product grid — standalone product cards and compare banner.
  Product price: original + Save checkbox; click reveals sale + strikethrough.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#E31C23'
  assign max_w = section.settings.content_max_width | default: 1200
  assign panel_bg = section.settings.panel_bg | default: '#F3F3F3'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --sv2s-accent: {{ accent }};
    --sv2s-save-bg: {{ section.settings.save_btn_bg | default: '#FFCC00' }};
    --sv2s-save-text: {{ section.settings.save_btn_text | default: '#000000' }};
    --sv2s-sale-color: {{ section.settings.sale_price_color | default: '#E53935' }};
    --sv2s-heading-font: 'Bebas Neue', 'Oswald', sans-serif;
    --sv2s-card-pad-x: calc(14 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s {
    width: 100%;
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    padding: calc({{ section.settings.padding_top | default: 36 }} * var(--rem)) 0 calc({{ section.settings.padding_bottom | default: 36 }} * var(--rem));
    margin: 0;
    border-bottom: 1px solid #eeeeee;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2s__inner {
    max-width: calc({{ max_w }} * var(--rem));
    width: 100%;
    margin: 0 auto;
    padding: 0 calc(16 * var(--rem));
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sv2s__grid-empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: calc(24 * var(--rem)) 0;
    text-align: center;
    font-size: calc(14 * var(--rem));
    color: #888888;
  }

  #shopify-section-{{ section.id }} .sv2s__panel-main {
    background: {{ panel_bg }};
    padding: calc(24 * var(--rem)) 0 calc(40 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s__products-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(12 * var(--rem));
    margin-bottom: calc(12 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s__products-title {
    margin: 0;
    font-family: var(--sv2s-heading-font);
    font-size: calc(32 * var(--rem));
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s__view-all {
    font-size: calc(14 * var(--rem));
    font-weight: 400;
    color: #333333;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sv2s__view-all:hover {
    color: var(--sv2s-accent);
  }

  #shopify-section-{{ section.id }} .sv2s__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(16 * var(--rem));
    margin-bottom: calc(32 * var(--rem));
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .sv2s-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: calc(4 * var(--rem));
    overflow: hidden;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .sv2s-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .sv2s-card__badge {
    position: absolute;
    top: calc(10 * var(--rem));
    left: calc(10 * var(--rem));
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: calc(3 * var(--rem)) calc(5 * var(--rem));
    background: var(--sv2s-accent);
    color: #ffffff;
    font-size: calc(11 * var(--rem));
    font-weight: 400;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    border-radius: calc(4 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__badge-line {
    display: block;
    margin: 0;
    padding: 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag {
    z-index: 2;
    padding: calc(5 * var(--rem)) calc(8 * var(--rem));
    background: #111111;
    color: #ffffff;
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: calc(4 * var(--rem));
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag--media {
    position: absolute;
    top: calc(10 * var(--rem));
    right: calc(10 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag--inline {
    display: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    padding: calc(14 * var(--rem)) var(--sv2s-card-pad-x) calc(16 * var(--rem));
    gap: calc(8 * var(--rem));
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sv2s-card__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .sv2s-card__aside {
    display: contents;
  }

  #shopify-section-{{ section.id }} .sv2s-card__title {
    margin: 0;
    font-size: calc(18 * var(--rem));
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sv2s-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--rem));
    font-size: calc(13 * var(--rem));
    color: #555555;
  }

  #shopify-section-{{ section.id }} .sv2s-card__stars {
    display: inline-flex;
    align-items: center;
    gap: calc(1 * var(--rem));
    color: var(--sv2s-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star {
    display: block;
    width: calc(13 * var(--rem));
    height: calc(13 * var(--rem));
    flex-shrink: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial {
    position: relative;
    display: block;
    width: calc(13 * var(--rem));
    height: calc(13 * var(--rem));
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial .sv2s-card__star {
    position: absolute;
    left: 0;
    top: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial .sv2s-card__star-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: var(--sv2s-star-fill, 50%);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--empty {
    color: #d0d0d0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(6 * var(--rem));
    width: calc(100% + 2 * var(--sv2s-card-pad-x));
    margin: calc(4 * var(--rem)) calc(-1 * var(--sv2s-card-pad-x)) 0;
    padding: calc(8 * var(--rem)) var(--sv2s-card-pad-x) 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: none;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--rem));
    text-align: left;
    font-size: calc(11 * var(--rem));
    color: #555555;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-icon {
    width: calc(16 * var(--rem));
    height: calc(16 * var(--rem));
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-label,
  #shopify-section-{{ section.id }} .sv2s-card__spec-value {
    display: block;
    width: 100%;
    line-height: 1.2;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-label {
    font-size: calc(10 * var(--rem));
    color: #999999;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-value {
    font-size: calc(11 * var(--rem));
    color: #333333;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: calc(2 * var(--rem)) calc(8 * var(--rem));
    width: 100%;
    margin: calc(4 * var(--rem)) 0 calc(8 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-main {
    font-size: calc(22 * var(--rem));
    font-weight: 600;
    color: #111111;
    line-height: 1.1;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price.is-saved .sv2s-card__price-main {
    color: var(--sv2s-sale-color);
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-compare {
    font-size: calc(13 * var(--rem));
    color: #999999;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-compare.is-hidden {
    display: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price]::before {
    content: '';
    flex-basis: 100%;
    width: 0;
    height: 0;
    order: 2;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-main,
  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-compare {
    order: 1;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save {
    order: 3;
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--rem));
    margin: 0;
    padding: calc(5 * var(--rem)) calc(8 * var(--rem));
    border: none;
    border-radius: calc(6 * var(--rem));
    background: var(--sv2s-save-bg);
    color: var(--sv2s-save-text);
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: 1.2;
    cursor: pointer;
    width: max-content;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check {
    appearance: none;
    -webkit-appearance: none;
    width: calc(12 * var(--rem));
    height: calc(12 * var(--rem));
    margin: 0;
    border: 1px solid currentColor;
    border-radius: calc(2 * var(--rem));
    background: #ffffff;
    position: relative;
    flex-shrink: 0;
    color: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check:checked {
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: calc(3 * var(--rem));
    height: calc(6 * var(--rem));
    border: solid var(--sv2s-save-bg);
    border-width: 0 1.5px 1.5px 0;
    transform: translate(-50%, -55%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .sv2s-card__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(44 * var(--rem));
    margin-top: auto;
    padding: calc(10 * var(--rem)) calc(12 * var(--rem));
    border: none;
    border-radius: calc(6 * var(--rem));
    background: {{ section.settings.atc_bg | default: '#111111' }};
    color: {{ section.settings.atc_text_color | default: '#ffffff' }};
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s-card__atc:hover {
    background: var(--sv2s-accent);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-card__form {
    display: contents;
  }

  #shopify-section-{{ section.id }} .sv2s-compare {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: calc(24 * var(--rem));
    align-items: center;
    padding: calc(36 * var(--rem)) calc(40 * var(--rem));
    margin-bottom: 0;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: calc(8 * var(--rem));
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__title {
    margin: 0 0 calc(10 * var(--rem));
    font-family: var(--sv2s-heading-font);
    font-size: calc(36 * var(--rem));
    font-weight: 400;
    font-style: normal;
    line-height: 1.15;
    text-transform: uppercase;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__text {
    margin: 0 0 calc(18 * var(--rem));
    font-size: calc(16 * var(--rem));
    color: #555555;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(46 * var(--rem));
    padding: calc(12 * var(--rem)) calc(22 * var(--rem));
    background: var(--sv2s-accent);
    color: #ffffff;
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: calc(6 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img--mobile {
    display: none;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sv2s__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .sv2s-compare {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sv2s__panel-main {
      padding: calc(20 * var(--rem)) 0 calc(28 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s__products-title {
      font-size: calc(38 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s__products-head {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .sv2s__view-all {
      font-size: calc(16 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s__grid {
      grid-template-columns: 1fr;
      gap: calc(12 * var(--rem));
      margin-bottom: calc(24 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card {
      flex-direction: row;
      align-items: stretch;
      gap: calc(10 * var(--rem));
      padding: 0;
      border-radius: calc(10 * var(--rem));
      height: auto;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .sv2s-card__media {
      flex: 0 0 calc(180 * var(--rem));
      width: calc(180 * var(--rem));
      aspect-ratio: 1 / 1;
      align-self: center;
    }

    #shopify-section-{{ section.id }} .sv2s-card__badge {
      top: calc(4 * var(--rem));
      left: calc(4 * var(--rem));
      padding: calc(2 * var(--rem)) calc(6 * var(--rem));
      font-size: calc(16 * var(--rem));
      border-radius: calc(6 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__tag--media {
      display: none;
    }

    #shopify-section-{{ section.id }} .sv2s-card__tag--inline {
      display: inline-flex;
      align-items: center;
      position: static;
      padding: calc(3 * var(--rem)) calc(7 * var(--rem));
      font-size: calc(9 * var(--rem));
      border-radius: calc(999 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__body {
      flex: 1;
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'head aside' 'rating aside' 'specs aside';
      align-items: start;
      column-gap: calc(8 * var(--rem));
      row-gap: calc(4 * var(--rem));
      padding: calc(20 * var(--rem));
      text-align: left;
    }

    #shopify-section-{{ section.id }} .sv2s-card__head {
      grid-area: head;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: calc(6 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__title {
      font-size: calc(28 * var(--rem));
      font-weight: 700;
      text-align: left;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .sv2s-card__rating {
      grid-area: rating;
      justify-content: flex-start;
      font-size: calc(18 * var(--rem));
      gap: calc(4 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__star,
    #shopify-section-{{ section.id }} .sv2s-card__star--partial {
      width: calc(18 * var(--rem));
      height: calc(18 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__specs {
      grid-area: specs;
      width: 94%;
      margin: calc(2 * var(--rem)) 0 0;
      padding: 0;
      border-top: none;
      gap: calc(8 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__spec {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: calc(8 * var(--rem));
      text-align: left;
    }

    #shopify-section-{{ section.id }} .sv2s-card__spec-icon {
      width: calc(24 * var(--rem));
      height: calc(24 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__spec-text {
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .sv2s-card__spec-value {
      font-size: calc(12 * var(--rem));
      font-weight: 600;
      color: #333333;
    }

    #shopify-section-{{ section.id }} .sv2s-card__spec-label {
      font-size: calc(12 * var(--rem));
      color: #999999;
    }

    #shopify-section-{{ section.id }} .sv2s-card__aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      align-self: stretch;
      width: calc(158 * var(--rem));
      min-width: calc(158 * var(--rem));
      max-width: calc(158 * var(--rem));
      gap: calc(8 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__price {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: calc(2 * var(--rem));
      width: 100%;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price]::before {
      display: none;
    }

    #shopify-section-{{ section.id }} .sv2s-card__price-main,
    #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-main {
      font-size: calc(24 * var(--rem));
      font-weight: 700;
      order: 1;
    }

    #shopify-section-{{ section.id }} .sv2s-card__price-compare,
    #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-compare {
      font-size: calc(14 * var(--rem));
      order: 2;
    }

    #shopify-section-{{ section.id }} .sv2s-card__save,
    #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__save {
      order: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: calc(6 * var(--rem));
      font-size: calc(16 * var(--rem));
      line-height: 1;
      padding: calc(6 * var(--rem)) calc(8 * var(--rem));
      margin-top: calc(4 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__save-check {
      width: calc(14 * var(--rem));
      height: calc(14 * var(--rem));
      align-self: center;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .sv2s-card__save > span {
      display: inline-flex;
      align-items: center;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .sv2s-card__form {
      display: block;
      width: 100%;
      margin-top: auto;
    }

    #shopify-section-{{ section.id }} .sv2s-card__atc {
      width: 100%;
      min-width: calc(108 * var(--rem));
      min-height: calc(42 * var(--rem));
      margin-top: 0;
      padding: calc(8 * var(--rem)) calc(10 * var(--rem));
      font-size: calc(14 * var(--rem));
      border-radius: calc(10 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-compare {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: calc(12 * var(--rem));
      padding: calc(24 * var(--rem)) calc(18 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-compare__content,
    #shopify-section-{{ section.id }} .sv2s-compare__media {
      width: 50%;
      flex: 0 0 50%;
      max-width: 50%;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .sv2s-compare__title {
      font-size: calc(38 * var(--rem));
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .sv2s-compare__text {
      margin-bottom: 0;
    }
  }
</style>

<div class="sv2s" data-sv2s-root>
  <div class="sv2s__panel-main">
    <div class="sv2s__inner">
      <div class="sv2s__products-head">
        <h2 class="sv2s__products-title">{{ section.settings.products_heading | default: 'BEST SELLERS' | escape }}</h2>
        {%- if section.settings.view_all_text != blank -%}
          <a class="sv2s__view-all" href="{{ section.settings.view_all_link | default: '#' }}">
            {{ section.settings.view_all_text | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="sv2s__grid">
        {%- assign product_count = 0 -%}
        {%- for product_block in section.blocks -%}
          {%- if product_block.type == 'product_card' -%}
            {%- assign product_count = product_count | plus: 1 -%}
            {%- liquid
              assign product = product_block.settings.product
              assign variant = product.selected_or_first_available_variant
              assign display_title = product_block.settings.title
              if display_title == blank and product != blank
                assign display_title = product.title
              endif
              assign card_image = product_block.settings.image
              if card_image == blank and product != blank
                assign card_image = product.featured_media
              endif
              assign product_url = '#'
              if product != blank
                assign product_url = product.url
              endif

              assign price_original_label = product_block.settings.original_price | strip
              assign price_sale_label = product_block.settings.sale_price | strip
              assign save_amount_label = product_block.settings.save_amount | strip

              if price_original_label == blank and product != blank
                assign price_original_label = product.price | money | strip_html
              endif
              if price_sale_label == blank and product != blank and save_amount_label != blank
                assign save_cents_tmp = save_amount_label | replace: '$', '' | replace: ',', '' | times: 100.0 | round
                assign price_sale_cents = product.price | minus: save_cents_tmp
                if price_sale_cents < 0
                  assign price_sale_cents = 0
                endif
                assign price_sale_label = price_sale_cents | money | strip_html
              endif
              if save_amount_label != blank
                unless save_amount_label contains '$'
                  assign save_amount_label = save_amount_label | prepend: '$'
                endunless
              endif

              assign form_id = 'sv2s-atc-' | append: section.id | append: '-' | append: product_block.id
              assign card_save_bg = product_block.settings.save_btn_bg | default: section.settings.save_btn_bg | default: '#FFCC00'
              assign card_save_text = product_block.settings.save_btn_text | default: section.settings.save_btn_text | default: '#000000'
              assign card_sale_color = product_block.settings.sale_price_color | default: section.settings.sale_price_color | default: '#E53935'
            -%}
            {%- assign corner_tag = product_block.settings.corner_tag | strip -%}
            <article class="sv2s-card" {{ product_block.shopify_attributes }}>
              <a class="sv2s-card__media" href="{{ product_url }}">
                {%- if product_block.settings.badge_text != blank -%}
                  <span class="sv2s-card__badge">
                    {%- assign badge_lines = product_block.settings.badge_text | newline_to_br | split: '<br />' -%}
                    {%- if badge_lines.size == 1 -%}
                      {%- assign badge_lines = product_block.settings.badge_text | newline_to_br | split: '<br>' -%}
                    {%- endif -%}
                    {%- for line in badge_lines -%}
                      {%- assign line_text = line | strip -%}
                      {%- if line_text != blank -%}
                        <span class="sv2s-card__badge-line">{{ line_text | escape }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if corner_tag != blank -%}
                  <span class="sv2s-card__tag sv2s-card__tag--media">{{ corner_tag | escape }}</span>
                {%- endif -%}
                {%- if card_image != blank -%}
                  {{ card_image
                    | image_url: width: 800
                    | image_tag:
                      widths: '300,400,600,800',
                      sizes: '(max-width: 749px) 30vw, 25vw',
                      loading: 'lazy',
                      alt: display_title
                  }}
                {%- endif -%}
              </a>

              <div class="sv2s-card__body">
                <div class="sv2s-card__head">
                  {%- if display_title != blank -%}
                    <h3 class="sv2s-card__title">
                      <a href="{{ product_url }}">{{ display_title | escape }}</a>
                    </h3>
                  {%- endif -%}
                  {%- if corner_tag != blank -%}
                    <span class="sv2s-card__tag sv2s-card__tag--inline">{{ corner_tag | escape }}</span>
                  {%- endif -%}
                </div>

                {%- render 'sv2s-product-rating', product: product -%}

                {%- if product_block.settings.spec_range != blank or product_block.settings.spec_speed != blank or product_block.settings.spec_motor != blank -%}
                  <div class="sv2s-card__specs">
                    <div class="sv2s-card__spec">
                      {%- if product_block.settings.spec_range_icon != blank -%}
                        {{ product_block.settings.spec_range_icon | image_url: width: 64 | image_tag: class: 'sv2s-card__spec-icon', widths: '32,64', sizes: '22px', loading: 'lazy', alt: '' }}
                      {%- endif -%}
                      <div class="sv2s-card__spec-text">
                        <span class="sv2s-card__spec-value">{{ product_block.settings.spec_range | default: '—' | escape }}</span>
                        <span class="sv2s-card__spec-label">{{ product_block.settings.spec_range_label | default: 'Range' | escape }}</span>
                      </div>
                    </div>
                    <div class="sv2s-card__spec">
                      {%- if product_block.settings.spec_speed_icon != blank -%}
                        {{ product_block.settings.spec_speed_icon | image_url: width: 64 | image_tag: class: 'sv2s-card__spec-icon', widths: '32,64', sizes: '22px', loading: 'lazy', alt: '' }}
                      {%- endif -%}
                      <div class="sv2s-card__spec-text">
                        <span class="sv2s-card__spec-value">{{ product_block.settings.spec_speed | default: '—' | escape }}</span>
                        <span class="sv2s-card__spec-label">{{ product_block.settings.spec_speed_label | default: 'Speed' | escape }}</span>
                      </div>
                    </div>
                    <div class="sv2s-card__spec">
                      {%- if product_block.settings.spec_motor_icon != blank -%}
                        {{ product_block.settings.spec_motor_icon | image_url: width: 64 | image_tag: class: 'sv2s-card__spec-icon', widths: '32,64', sizes: '22px', loading: 'lazy', alt: '' }}
                      {%- endif -%}
                      <div class="sv2s-card__spec-text">
                        <span class="sv2s-card__spec-value">{{ product_block.settings.spec_motor | default: '—' | escape }}</span>
                        <span class="sv2s-card__spec-label">{{ product_block.settings.spec_motor_label | default: 'Motor' | escape }}</span>
                      </div>
                    </div>
                  </div>
                {%- endif -%}

                <div class="sv2s-card__aside">
                  {%- if save_amount_label != blank and price_original_label != blank -%}
                    <div
                      class="sv2s-card__price"
                      data-sv2s-price
                      data-price-sale="{{ price_sale_label | escape }}"
                      data-price-original="{{ price_original_label | escape }}"
                      style="--sv2s-save-bg: {{ card_save_bg }}; --sv2s-save-text: {{ card_save_text }}; --sv2s-sale-color: {{ card_sale_color }};"
                    >
                      <span class="sv2s-card__price-main" data-sv2s-price-main>{{ price_original_label }}</span>
                      <span class="sv2s-card__price-compare is-hidden" data-sv2s-price-compare>{{ price_original_label }}</span>
                      <label class="sv2s-card__save" data-sv2s-save-btn aria-pressed="false">
                        <input
                          type="checkbox"
                          class="sv2s-card__save-check"
                          data-sv2s-save-check
                          aria-label="Apply save {{ save_amount_label | escape }}"
                        >
                        <span>Save {{ save_amount_label }}</span>
                      </label>
                    </div>
                  {%- elsif price_original_label != blank or price_sale_label != blank -%}
                    <div class="sv2s-card__price{% if price_original_label != blank and price_sale_label != blank and price_original_label != price_sale_label %} is-saved{% endif %}" style="--sv2s-sale-color: {{ card_sale_color }};">
                      <span class="sv2s-card__price-main">{{ price_sale_label | default: price_original_label }}</span>
                      {%- if price_original_label != blank and price_sale_label != blank and price_original_label != price_sale_label -%}
                        <span class="sv2s-card__price-compare">{{ price_original_label }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if product != blank and product.available -%}
                    {%- form 'product', product, id: form_id, is: 'product-form', class: 'sv2s-card__form' -%}
                      <input type="hidden" name="id" value="{{ variant.id }}">
                      <button type="submit" class="sv2s-card__atc" name="add">
                        {{ section.settings.atc_text | default: 'ADD TO CART' }}
                      </button>
                    {%- endform -%}
                  {%- elsif product_block.settings.atc_link != blank -%}
                    <a class="sv2s-card__atc" href="{{ product_block.settings.atc_link }}">
                      {{ section.settings.atc_text | default: 'ADD TO CART' }}
                    </a>
                  {%- else -%}
                    <a class="sv2s-card__atc" href="{{ product_url }}">
                      {{ section.settings.atc_text | default: 'ADD TO CART' }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        {%- if product_count == 0 -%}
          <p class="sv2s__grid-empty">Add Product card blocks to show products.</p>
        {%- endif -%}
      </div>

      {%- if section.settings.compare_heading != blank or section.settings.compare_image != blank or section.settings.compare_image_mobile != blank -%}
        <div class="sv2s-compare">
          <div class="sv2s-compare__content">
            {%- if section.settings.compare_heading != blank -%}
              <h2 class="sv2s-compare__title">{{ section.settings.compare_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.compare_text != blank -%}
              <p class="sv2s-compare__text">{{ section.settings.compare_text | escape }}</p>
            {%- endif -%}
            {%- if section.settings.compare_btn_text != blank -%}
              <a class="sv2s-compare__btn" href="{{ section.settings.compare_btn_link | default: '#' }}">
                {{ section.settings.compare_btn_text | escape }}
              </a>
            {%- endif -%}
          </div>
          {%- if section.settings.compare_image != blank or section.settings.compare_image_mobile != blank -%}
            <div class="sv2s-compare__media">
              {%- if section.settings.compare_image != blank -%}
                {{ section.settings.compare_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'sv2s-compare__img sv2s-compare__img--desktop',
                    widths: '600,900,1200',
                    sizes: '40vw',
                    loading: 'lazy',
                    alt: section.settings.compare_heading
                }}
              {%- endif -%}
              {%- if section.settings.compare_image_mobile != blank -%}
                {{ section.settings.compare_image_mobile
                  | image_url: width: 900
                  | image_tag:
                    class: 'sv2s-compare__img sv2s-compare__img--mobile',
                    widths: '400,600,900',
                    sizes: '50vw',
                    loading: 'lazy',
                    alt: section.settings.compare_heading
                }}
              {%- elsif section.settings.compare_image != blank -%}
                {{ section.settings.compare_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'sv2s-compare__img sv2s-compare__img--mobile',
                    widths: '400,600,900',
                    sizes: '50vw',
                    loading: 'lazy',
                    alt: section.settings.compare_heading
                }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionSelector = '#shopify-section-{{ section.id }}';

    function setSaveActive(priceWrap, active) {
      if (!priceWrap) return;
      var main = priceWrap.querySelector('[data-sv2s-price-main]');
      var compare = priceWrap.querySelector('[data-sv2s-price-compare]');
      var btn = priceWrap.querySelector('[data-sv2s-save-btn]');
      var check = priceWrap.querySelector('[data-sv2s-save-check]');
      var sale = priceWrap.getAttribute('data-price-sale') || '';
      var original = priceWrap.getAttribute('data-price-original') || '';
      priceWrap.classList.toggle('is-saved', active);
      if (btn) {
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      if (check) check.checked = active;
      if (main) main.textContent = active ? sale : original;
      if (compare) {
        compare.textContent = original;
        compare.classList.toggle('is-hidden', !active);
      }
    }

    function initSv2s(root) {
      if (!root || root.getAttribute('data-sv2s-ready') === '1') return;
      root.setAttribute('data-sv2s-ready', '1');

      root.querySelectorAll('[data-sv2s-price]').forEach(function (priceWrap) {
        var check = priceWrap.querySelector('[data-sv2s-save-check]');
        if (!check) return;
        setSaveActive(priceWrap, check.checked);
        check.addEventListener('change', function () {
          setSaveActive(priceWrap, check.checked);
        });
      });
    }

    function boot(event) {
      if (event && event.target && !event.target.matches(sectionSelector)) return;
      document.querySelectorAll(sectionSelector + ' [data-sv2s-root]').forEach(initSv2s);
    }

    boot();
    document.addEventListener('shopify:section:load', boot);
    document.addEventListener('shopify:section:reorder', boot);
  })();
</script>

