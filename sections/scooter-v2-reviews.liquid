{%- comment -%}
  Scooter collection v2 — auto-playing reviews carousel.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#E31C23'
  assign max_w = section.settings.content_max_width | default: 1100
  assign autoplay_ms = section.settings.autoplay_speed | default: 4 | times: 1000
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --sv2r-accent: {{ accent }};
    --sv2r-gap: calc(16 * var(--rem));
    --sv2s-heading-font: 'Bebas Neue', 'Oswald', sans-serif;
  }

  #shopify-section-{{ section.id }} .sv2r {
    width: 100%;
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    padding: calc({{ section.settings.padding_top | default: 34 }} * var(--rem)) calc(16 * var(--rem)) calc({{ section.settings.padding_bottom | default: 34 }} * var(--rem));
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sv2r__inner {
    max-width: calc({{ max_w }} * var(--rem));
    width: 100%;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sv2r__header {
    text-align: center;
    margin-bottom: calc(12 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2r__title {
    margin: 0 0 calc(8 * var(--rem));
    font-family: var(--sv2s-heading-font);
    font-size: calc({{ section.settings.title_size | default: 32 }} * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.title_color | default: '#111111' }};
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .sv2r__subtitle {
    margin: 0;
    font-size: calc({{ section.settings.subtitle_size | default: 16 }} * var(--rem));
    font-weight: 600;
    color: {{ section.settings.subtitle_color | default: '#111111' }};
  }

  #shopify-section-{{ section.id }} .sv2r__viewport {
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .sv2r__track {
    display: flex;
    gap: var(--sv2r-gap);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .sv2r__card {
    flex: 0 0 calc((100% - 2 * var(--sv2r-gap)) / 3);
    min-width: 0;
    background: {{ section.settings.card_bg | default: '#F7F7F7' }};
    border-radius: calc(6 * var(--rem));
    padding: calc(12 * var(--rem));
    box-sizing: border-box;
  }

  /* 左图右文 */
  #shopify-section-{{ section.id }} .sv2r__card-inner {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: calc(14 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2r__thumb {
    width: calc(100 * var(--rem));
    height: calc(108 * var(--rem));
    border-radius: calc(4 * var(--rem));
    object-fit: cover;
    background: #eaeaea;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2r__card-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2r__stars {
    display: inline-flex;
    align-items: center;
    gap: calc(2 * var(--rem));
    color: var(--sv2r-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .sv2r__star {
    display: block;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    flex-shrink: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2r__star--partial {
    position: relative;
    display: block;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2r__star--partial .sv2r__star {
    position: absolute;
    left: 0;
    top: 0;
  }

  #shopify-section-{{ section.id }} .sv2r__star--partial .sv2r__star-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: var(--sv2r-star-fill, 50%);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sv2r__star--empty {
    color: #d0d0d0;
  }

  #shopify-section-{{ section.id }} .sv2r__headline {
    margin: 0;
    font-size: calc(16 * var(--rem));
    font-weight: 600;
    color: #111111;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .sv2r__body {
    margin: 0;
    font-size: calc(14 * var(--rem));
    color: #555555;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .sv2r__author {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--rem));
    margin-top: calc(4 * var(--rem));
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    color: #222222;
  }

  #shopify-section-{{ section.id }} .sv2r__verified {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(16 * var(--rem));
    height: calc(16 * var(--rem));
    border-radius: 50%;
    background: #111111;
    color: #ffffff;
    font-size: calc(10 * var(--rem));
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .sv2r__dots {
    display: flex;
    justify-content: center;
    gap: calc(8 * var(--rem));
    margin-top: calc(22 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2r__dot {
    width: calc(8 * var(--rem));
    height: calc(8 * var(--rem));
    border-radius: 50%;
    border: none;
    padding: 0;
    background: #cccccc;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sv2r__dot.is-active {
    background: var(--sv2r-accent);
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sv2r__card {
      flex-basis: calc((100% - var(--sv2r-gap)) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sv2r__title {
      font-size: calc({{ section.settings.title_size_mobile | default: 28 }} * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2r__card {
      flex-basis: 85%;
    }

    #shopify-section-{{ section.id }} .sv2r__thumb {
      width: calc(64 * var(--rem));
      height: calc(64 * var(--rem));
    }
  }
</style>

<section class="sv2r" data-sv2r-root data-autoplay="{{ autoplay_ms }}">
  <div class="sv2r__inner">
    <div class="sv2r__header">
      {%- if section.settings.title != blank -%}
        <h2 class="sv2r__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="sv2r__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sv2r__viewport">
        <div class="sv2r__track" data-sv2r-track>
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <article class="sv2r__card" {{ block.shopify_attributes }}>
                <div class="sv2r__card-inner">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image
                      | image_url: width: 200
                      | image_tag: class: 'sv2r__thumb', widths: '80,160,200', sizes: '72px', loading: 'lazy', alt: block.settings.author
                    }}
                  {%- else -%}
                    <div class="sv2r__thumb" aria-hidden="true"></div>
                  {%- endif -%}
                  <div class="sv2r__card-content">
                    {%- liquid
                      assign rating_raw = block.settings.rating | strip
                      if rating_raw == blank
                        assign rating_raw = '5'
                      endif
                      assign rating_num = rating_raw | times: 1.0
                      if rating_num < 1
                        assign rating_num = 1.0
                      endif
                      if rating_num > 5
                        assign rating_num = 5.0
                      endif
                    -%}
                    <div class="sv2r__stars" aria-label="{{ rating_num }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        {%- assign star_index = i -%}
                        {%- assign star_prev = i | minus: 1 -%}
                        {%- if rating_num >= star_index -%}
                          <svg class="sv2r__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path
                              fill="currentColor"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round"
                              stroke-linecap="round"
                              d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                            />
                          </svg>
                        {%- elsif rating_num > star_prev -%}
                          {%- assign fill_frac = rating_num | minus: star_prev -%}
                          {%- assign fill_pct = fill_frac | times: 100 -%}
                          <span class="sv2r__star--partial" style="--sv2r-star-fill: {{ fill_pct }}%;">
                            <svg class="sv2r__star sv2r__star--empty" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                              <path
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linejoin="round"
                                stroke-linecap="round"
                                d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                              />
                            </svg>
                            <span class="sv2r__star-fill">
                              <svg class="sv2r__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path
                                  fill="currentColor"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round"
                                  stroke-linecap="round"
                                  d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                                />
                              </svg>
                            </span>
                          </span>
                        {%- else -%}
                          <svg class="sv2r__star sv2r__star--empty" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round"
                              stroke-linecap="round"
                              d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                            />
                          </svg>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    {%- if block.settings.headline != blank -%}
                      <h3 class="sv2r__headline">{{ block.settings.headline | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <p class="sv2r__body">{{ block.settings.body | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.author != blank -%}
                      <div class="sv2r__author">
                        <span>{{ block.settings.author | escape }}</span>
                        {%- if block.settings.verified -%}
                          <span class="sv2r__verified" title="Verified">✓</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="sv2r__dots" data-sv2r-dots aria-hidden="true"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-sv2r-root]');
    if (!root) return;
    var track = root.querySelector('[data-sv2r-track]');
    var dotsWrap = root.querySelector('[data-sv2r-dots]');
    if (!track) return;

    var cards = Array.prototype.slice.call(track.children);
    if (!cards.length) return;

    var autoplay = parseInt(root.getAttribute('data-autoplay'), 10) || 4000;
    var index = 0;
    var timer = null;

    function trackGap() {
      var styles = window.getComputedStyle(track);
      var g = parseFloat(styles.columnGap || styles.gap) || 0;
      return g;
    }

    function perView() {
      var w = window.innerWidth;
      if (w <= 749) return 1;
      if (w <= 999) return 2;
      return 3;
    }

    function maxIndex() {
      return Math.max(0, cards.length - perView());
    }

    function cardStep() {
      var card = cards[0];
      return card.getBoundingClientRect().width + trackGap();
    }

    function renderDots() {
      if (!dotsWrap) return;
      var count = maxIndex() + 1;
      dotsWrap.innerHTML = '';
      for (var i = 0; i < count; i++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sv2r__dot' + (i === index ? ' is-active' : '');
        btn.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        (function (iCopy) {
          btn.addEventListener('click', function () {
            goTo(iCopy);
            restart();
          });
        })(i);
        dotsWrap.appendChild(btn);
      }
    }

    function goTo(i) {
      index = Math.max(0, Math.min(i, maxIndex()));
      track.style.transition = 'transform 0.55s ease';
      track.style.transform = 'translate3d(' + (-index * cardStep()) + 'px,0,0)';
      if (dotsWrap) {
        Array.prototype.forEach.call(dotsWrap.children, function (dot, di) {
          dot.classList.toggle('is-active', di === index);
        });
      }
    }

    function next() {
      var max = maxIndex();
      goTo(index >= max ? 0 : index + 1);
    }

    function restart() {
      if (timer) clearInterval(timer);
      if (autoplay > 0 && cards.length > perView()) {
        timer = setInterval(next, autoplay);
      }
    }

    function onResize() {
      if (index > maxIndex()) index = maxIndex();
      renderDots();
      goTo(index);
      restart();
    }

    renderDots();
    goTo(0);
    restart();
    window.addEventListener('resize', onResize);

    root.addEventListener('mouseenter', function () {
      if (timer) clearInterval(timer);
    });
    root.addEventListener('mouseleave', restart);
  })();
</script>

{% schema %}
{
  "name": "Scooter V2 Reviews",
  "tag": "section",
  "class": "scooter-v2-reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "TRUSTED BY EVERYDAY RIDERS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "4.9/5 from 181 verified reviews"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Star / accent color",
      "default": "#E31C23"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width (rem)",
      "info": "Design px at 1440; rendered as calc(N * var(--rem)).",
      "min": 960,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Star rating",
          "info": "1–5, decimals allowed (e.g. 4.5, 4.3).",
          "default": "5"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Perfect daily commute scooter"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "Smooth ride, solid build, and battery lasts through my weekdays."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Alex M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scooter V2 Reviews",
      "blocks": [
        { "type": "review", "settings": { "headline": "Best value under $300", "author": "Jordan P." } },
        { "type": "review", "settings": { "headline": "Smooth and quiet", "author": "Sam R." } },
        { "type": "review", "settings": { "headline": "Battery holds up", "author": "Casey L." } },
        { "type": "review", "settings": { "headline": "Great for campus", "author": "Riley K." } }
      ]
    }
  ]
}
{% endschema %}
