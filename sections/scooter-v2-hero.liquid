{%- comment -%}
  Scooter collection v2 — full-bleed hero with title, CTAs, and trust row.
{%- endcomment -%}

{%- liquid
  assign hero_overlay = section.settings.overlay_color | default: '#000000'
  assign hero_overlay_opacity = section.settings.overlay_opacity | default: 35
  assign accent = section.settings.accent_color | default: '#E31C23'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --sv2h-accent: {{ accent }};
    --sv2h-overlay: {{ hero_overlay }};
    --sv2h-overlay-opacity: {{ hero_overlay_opacity | times: 0.01 }};
  }

  #shopify-section-{{ section.id }} .sv2h {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.min_height | default: 560 }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: {{ section.settings.text_color | default: '#ffffff' }};
    overflow: hidden;
    background: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .sv2h__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .sv2h__media img,
  #shopify-section-{{ section.id }} .sv2h__media .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .sv2h__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--sv2h-overlay);
    opacity: var(--sv2h-overlay-opacity);
  }

  #shopify-section-{{ section.id }} .sv2h__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ section.settings.content_max_width | default: 900 }}px;
    padding: 48px 20px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .sv2h__title {
    margin: 0;
    font-family: var(--heading-font-family);
    font-size: {{ section.settings.title_size | default: 56 }}px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sv2h__subtitle {
    margin: 0;
    font-size: {{ section.settings.subtitle_size | default: 18 }}px;
    line-height: 1.4;
    opacity: 0.95;
    max-width: 520px;
  }

  #shopify-section-{{ section.id }} .sv2h__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .sv2h__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 2px;
    transition: filter 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2h__btn--primary {
    background: var(--sv2h-accent);
    color: #ffffff;
    border: 2px solid var(--sv2h-accent);
  }

  #shopify-section-{{ section.id }} .sv2h__btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  #shopify-section-{{ section.id }} .sv2h__btn:hover {
    filter: brightness(1.05);
  }

  #shopify-section-{{ section.id }} .sv2h__trust {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: auto;
    padding: 18px 16px 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 40px;
  }

  #shopify-section-{{ section.id }} .sv2h__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .sv2h__trust-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sv2h {
      min-height: {{ section.settings.min_height_mobile | default: 480 }}px;
    }

    #shopify-section-{{ section.id }} .sv2h__title {
      font-size: {{ section.settings.title_size_mobile | default: 32 }}px;
    }

    #shopify-section-{{ section.id }} .sv2h__subtitle {
      font-size: {{ section.settings.subtitle_size_mobile | default: 15 }}px;
    }

    #shopify-section-{{ section.id }} .sv2h__actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    #shopify-section-{{ section.id }} .sv2h__btn {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .sv2h__trust {
      gap: 14px 24px;
      padding-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .sv2h__trust-item {
      font-size: 12px;
    }
  }
</style>

<section class="sv2h">
  <div class="sv2h__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '800,1200,1600,2000,2400',
          sizes: '100vw',
          loading: 'eager',
          alt: section.settings.title
      }}
    {%- else -%}
      <div class="placeholder" style="background: linear-gradient(135deg, #333, #111);"></div>
    {%- endif -%}
  </div>

  <div class="sv2h__inner">
    {%- if section.settings.title != blank -%}
      <h1 class="sv2h__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="sv2h__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <div class="sv2h__actions">
      {%- if section.settings.btn1_text != blank -%}
        <a class="sv2h__btn sv2h__btn--primary" href="{{ section.settings.btn1_link | default: '#' }}">
          {{ section.settings.btn1_text | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a class="sv2h__btn sv2h__btn--secondary" href="{{ section.settings.btn2_link | default: '#' }}">
          {{ section.settings.btn2_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="sv2h__trust">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' -%}
          {%- if block.settings.link != blank -%}
            <a class="sv2h__trust-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <span class="sv2h__trust-item" {{ block.shopify_attributes }}>
          {%- endif -%}
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon
                | image_url: width: 80
                | image_tag: class: 'sv2h__trust-icon', widths: '40,80', sizes: '28px', loading: 'lazy', alt: ''
              }}
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Scooter V2 Hero",
  "tag": "section",
  "class": "scooter-v2-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Primary button color",
      "default": "#E31C23"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height (desktop)",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min height (mobile)",
      "min": 360,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FIND YOUR PERFECT RIDE"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Reliable electric scooters for every commute."
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Subtitle size (mobile)",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary button text",
      "default": "SHOP BEST SELLERS"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary button text",
      "default": "COMPARE MODELS"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "UL Certified"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scooter V2 Hero",
      "blocks": [
        { "type": "trust", "settings": { "text": "UL Certified" } },
        { "type": "trust", "settings": { "text": "Free Shipping" } },
        { "type": "trust", "settings": { "text": "30-Day Returns" } }
      ]
    }
  ]
}
{% endschema %}
