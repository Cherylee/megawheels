{%- comment -%}
  Scooter collection v2 — full-bleed hero with title, CTAs, and trust row.
{%- endcomment -%}

{%- liquid
  assign hero_overlay = section.settings.overlay_color | default: '#000000'
  assign hero_overlay_opacity = section.settings.overlay_opacity | default: 35
  assign accent = section.settings.accent_color | default: '#E31C23'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --sv2h-accent: {{ accent }};
    --sv2h-overlay: {{ hero_overlay }};
    --sv2h-overlay-opacity: {{ hero_overlay_opacity | times: 0.01 }};
    --sv2s-heading-font: 'Bebas Neue', 'Oswald', sans-serif;
  }

  #shopify-section-{{ section.id }} .sv2h {
    position: relative;
    width: 100%;
    min-height: calc({{ section.settings.min_height | default: 560 }} * var(--rem));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    color: {{ section.settings.text_color | default: '#ffffff' }};
    overflow: hidden;
    background: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .sv2h__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .sv2h__media img,
  #shopify-section-{{ section.id }} .sv2h__media .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PC：左侧黑色渐变，约占整块 banner 宽度的 50% */
  #shopify-section-{{ section.id }} .sv2h__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.82) 28%,
      rgba(0, 0, 0, 0.62) 38%,
      rgba(0, 0, 0, 0.28) 48%,
      rgba(0, 0, 0, 0) 50%
    );
    opacity: 1;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sv2h__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: calc({{ section.settings.content_max_width | default: 1100 }} * var(--rem));
    margin: 0;
    padding: 0 calc(48 * var(--rem));
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(10 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2h__title {
    margin: 0 0 calc(2 * var(--rem));
    font-family: var(--sv2s-heading-font);
    font-size: calc({{ section.settings.title_size | default: 80 }} * var(--rem));
    font-weight: {{ section.settings.title_weight | default: 500 }};
    font-style: italic;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    max-width: 12em;
    white-space: normal;
  }

  #shopify-section-{{ section.id }} .sv2h__subtitle {
    margin: 0;
    font-size: calc({{ section.settings.subtitle_size | default: 18 }} * var(--rem));
    line-height: 1.4;
    opacity: 0.95;
    max-width: calc(520 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2h__actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(12 * var(--rem));
    justify-content: flex-start;
    margin-top: calc(4 * var(--rem));
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sv2h__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(48 * var(--rem));
    padding: calc(12 * var(--rem)) calc(22 * var(--rem));
    font-size: calc(14 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: calc(6 * var(--rem));
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease, backdrop-filter 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2h__btn--primary {
    background: var(--sv2h-accent);
    color: #ffffff;
    border: 2px solid var(--sv2h-accent);
  }

  #shopify-section-{{ section.id }} .sv2h__btn--primary:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .sv2h__btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
  }

  #shopify-section-{{ section.id }} .sv2h__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .sv2h__trust {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: calc(28 * var(--rem)) 0 0;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: calc(20 * var(--rem)) calc(32 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2h__trust-item {
    display: inline-flex;
    align-items: center;
    gap: calc(10 * var(--rem));
    color: inherit;
    text-decoration: none;
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .sv2h__trust-icon {
    width: calc(28 * var(--rem));
    height: calc(28 * var(--rem));
    object-fit: contain;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sv2h {
      min-height: calc({{ section.settings.min_height_mobile | default: 480 }} * var(--rem));
      align-items: center;
      text-align: center;
    }

    /* 手机端改为底部渐变，避免左对齐文案被盖住 */
    #shopify-section-{{ section.id }} .sv2h__media::after {
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.45) 40%,
        rgba(0, 0, 0, 0) 70%
      );
    }

    #shopify-section-{{ section.id }} .sv2h__inner {
      align-items: center;
      padding: 0 calc(20 * var(--rem));
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .sv2h__title {
      font-size: calc({{ section.settings.title_size_mobile | default: 36 }} * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2h__subtitle {
      font-size: calc({{ section.settings.subtitle_size_mobile | default: 15 }} * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2h__actions {
      flex-direction: column;
      justify-content: center;
      width: 100%;
      max-width: calc(320 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2h__btn {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .sv2h__trust {
      justify-content: center;
      gap: calc(14 * var(--rem)) calc(24 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2h__trust-item {
      font-size: calc(12 * var(--rem));
    }
  }
</style>

<section class="sv2h">
  <div class="sv2h__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '800,1200,1600,2000,2400',
          sizes: '100vw',
          loading: 'eager',
          alt: section.settings.title
      }}
    {%- else -%}
      <div class="placeholder" style="background: linear-gradient(135deg, #333, #111);"></div>
    {%- endif -%}
  </div>

  <div class="sv2h__inner">
    {%- if section.settings.title != blank -%}
      <h1 class="sv2h__title">{{ section.settings.title | newline_to_br }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="sv2h__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <div class="sv2h__actions">
      {%- if section.settings.btn1_text != blank -%}
        <a class="sv2h__btn sv2h__btn--primary" href="{{ section.settings.btn1_link | default: '#' }}">
          {{ section.settings.btn1_text | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a class="sv2h__btn sv2h__btn--secondary" href="{{ section.settings.btn2_link | default: '#' }}">
          {{ section.settings.btn2_text | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sv2h__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            {%- if block.settings.link != blank -%}
              <a class="sv2h__trust-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <span class="sv2h__trust-item" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon
                  | image_url: width: 96
                  | image_tag:
                    class: 'sv2h__trust-icon',
                    widths: '48,72,96',
                    sizes: '28px',
                    loading: 'lazy',
                    alt: block.settings.text
                }}
              {%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Scooter V2 Hero",
  "tag": "section",
  "class": "scooter-v2-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Primary button color",
      "default": "#E31C23"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height (desktop)",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min height (mobile)",
      "min": 360,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width (rem)",
      "info": "Design px at 1440; rendered as calc(N * var(--rem)).",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "FIND YOUR\nPERFECT RIDE",
      "info": "Press Enter to wrap onto a new line."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" },
        { "value": "800", "label": "800" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size (PC)",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Reliable electric scooters for every commute."
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Subtitle size (mobile)",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary button text",
      "default": "SHOP BEST SELLERS"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary button text",
      "default": "COMPARE MODELS"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Upload a trust icon (PNG/SVG recommended). Shown before the text."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "UL Certified"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scooter V2 Hero",
      "blocks": [
        { "type": "trust", "settings": { "text": "UL Certified" } },
        { "type": "trust", "settings": { "text": "Free Shipping" } },
        { "type": "trust", "settings": { "text": "30-Day Returns" } }
      ]
    }
  ]
}
{% endschema %}
