      padding: calc(6 * var(--rem)) calc(8 * var(--rem));
      margin-top: calc(4 * var(--rem));
    }

    #shopify-section-{{ section.id }} .sv2s-card__save-check {
      width: calc(14 * var(--rem));
      height: calc(14 * var(--rem));
      align-self: center;
