{%- comment -%}
  Scooter collection v2 — riding-style tabs.
  Each tab shows: product grid + compare banner + image/text feature panel.
  Product price: original + Save checkbox; click reveals sale + strikethrough.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#E31C23'
  assign max_w = section.settings.content_max_width | default: 1100
  assign panel_bg = section.settings.panel_bg | default: '#F3F3F3'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --sv2s-accent: {{ accent }};
    --sv2s-save-bg: {{ section.settings.save_btn_bg | default: '#FFCC00' }};
    --sv2s-save-text: {{ section.settings.save_btn_text | default: '#000000' }};
    --sv2s-sale-color: {{ section.settings.sale_price_color | default: '#E53935' }};
    --sv2s-heading-font: 'Bebas Neue', 'Oswald', sans-serif;
    --sv2s-card-pad-x: calc(14 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s {
    width: 100%;
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    padding: calc({{ section.settings.padding_top | default: 36 }} * var(--rem)) 0 0;
    margin-bottom: 0;
    border-bottom: 1px solid #eeeeee;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2s__inner {
    max-width: calc({{ max_w }} * var(--rem));
    width: 100%;
    margin: 0 auto;
    padding: 0 calc(16 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s__heading {
    margin: 0 0 calc(28 * var(--rem));
    text-align: center;
    font-family: var(--sv2s-heading-font);
    font-size: calc({{ section.settings.heading_size | default: 32 }} * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#111111' }};
    line-height: 1.1;
  }

  /* ===== Tabs ===== */
  #shopify-section-{{ section.id }} .sv2s__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(12 * var(--rem));
    margin-bottom: 0;
    list-style: none;
    padding: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2s__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(4 * var(--rem));
    padding: calc(18 * var(--rem)) calc(12 * var(--rem)) calc(16 * var(--rem));
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: calc(4 * var(--rem));
    cursor: pointer;
    text-align: center;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s__tab:hover {
    box-shadow: 0 calc(4 * var(--rem)) calc(14 * var(--rem)) rgba(0, 0, 0, 0.06);
  }

  #shopify-section-{{ section.id }} .sv2s__tab.is-active {
    border-color: #111111;
    border-bottom: calc(3 * var(--rem)) solid var(--sv2s-accent);
    box-shadow: 0 calc(4 * var(--rem)) calc(16 * var(--rem)) rgba(0, 0, 0, 0.08);
  }

  #shopify-section-{{ section.id }} .sv2s__tab-icon {
    width: calc(36 * var(--rem));
    height: calc(36 * var(--rem));
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .sv2s__tab-title {
    margin: 0;
    font-size: calc(15 * var(--rem));
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s__tab-sub {
    margin: 0;
    font-size: calc(12 * var(--rem));
    color: #777777;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .sv2s__panel {
    display: none;
    margin-top: calc(24 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s__panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .sv2s__grid-empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: calc(24 * var(--rem)) 0;
    text-align: center;
    font-size: calc(14 * var(--rem));
    color: #888888;
  }

  #shopify-section-{{ section.id }} .sv2s__panel-main {
    background: {{ panel_bg }};
    padding: calc(24 * var(--rem)) 0 calc(40 * var(--rem));
  }

  /* ===== Products ===== */
  #shopify-section-{{ section.id }} .sv2s__products-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(12 * var(--rem));
    margin-bottom: calc(12 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s__products-title {
    margin: 0;
    font-family: var(--sv2s-heading-font);
    font-size: calc(32 * var(--rem));
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s__view-all {
    font-size: calc(14 * var(--rem));
    font-weight: 400;
    color: #333333;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sv2s__view-all:hover {
    color: var(--sv2s-accent);
  }

  #shopify-section-{{ section.id }} .sv2s__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(16 * var(--rem));
    margin-bottom: calc(32 * var(--rem));
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .sv2s-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: calc(4 * var(--rem));
    overflow: hidden;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .sv2s-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .sv2s-card__badge {
    position: absolute;
    top: calc(10 * var(--rem));
    left: calc(10 * var(--rem));
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: calc(3 * var(--rem)) calc(5 * var(--rem));
    background: var(--sv2s-accent);
    color: #ffffff;
    font-size: calc(11 * var(--rem));
    font-weight: 400;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    border-radius: calc(4 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__badge-line {
    display: block;
    margin: 0;
    padding: 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag {
    z-index: 2;
    padding: calc(5 * var(--rem)) calc(8 * var(--rem));
    background: #111111;
    color: #ffffff;
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: calc(4 * var(--rem));
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag--media {
    position: absolute;
    top: calc(10 * var(--rem));
    right: calc(10 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__tag--inline {
    display: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    padding: calc(14 * var(--rem)) var(--sv2s-card-pad-x) calc(16 * var(--rem));
    gap: calc(8 * var(--rem));
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sv2s-card__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .sv2s-card__aside {
    display: contents;
  }

  #shopify-section-{{ section.id }} .sv2s-card__title {
    margin: 0;
    font-size: calc(18 * var(--rem));
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sv2s-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--rem));
    font-size: calc(13 * var(--rem));
    color: #555555;
  }

  #shopify-section-{{ section.id }} .sv2s-card__stars {
    display: inline-flex;
    align-items: center;
    gap: calc(1 * var(--rem));
    color: var(--sv2s-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star {
    display: block;
    width: calc(13 * var(--rem));
    height: calc(13 * var(--rem));
    flex-shrink: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial {
    position: relative;
    display: block;
    width: calc(13 * var(--rem));
    height: calc(13 * var(--rem));
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial .sv2s-card__star {
    position: absolute;
    left: 0;
    top: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--partial .sv2s-card__star-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: var(--sv2s-star-fill, 50%);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sv2s-card__star--empty {
    color: #d0d0d0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(6 * var(--rem));
    width: calc(100% + 2 * var(--sv2s-card-pad-x));
    margin: calc(4 * var(--rem)) calc(-1 * var(--sv2s-card-pad-x)) 0;
    padding: calc(8 * var(--rem)) var(--sv2s-card-pad-x) 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: none;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--rem));
    text-align: left;
    font-size: calc(11 * var(--rem));
    color: #555555;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-icon {
    width: calc(16 * var(--rem));
    height: calc(16 * var(--rem));
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-label,
  #shopify-section-{{ section.id }} .sv2s-card__spec-value {
    display: block;
    width: 100%;
    line-height: 1.2;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-label {
    font-size: calc(10 * var(--rem));
    color: #999999;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sv2s-card__spec-value {
    font-size: calc(11 * var(--rem));
    color: #333333;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: calc(2 * var(--rem)) calc(8 * var(--rem));
    width: 100%;
    margin: calc(4 * var(--rem)) 0 calc(8 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-main {
    font-size: calc(22 * var(--rem));
    font-weight: 600;
    color: #111111;
    line-height: 1.1;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price.is-saved .sv2s-card__price-main {
    color: var(--sv2s-sale-color);
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-compare {
    font-size: calc(13 * var(--rem));
    color: #999999;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price-compare.is-hidden {
    display: none;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price]::before {
    content: '';
    flex-basis: 100%;
    width: 0;
    height: 0;
    order: 2;
  }

  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-main,
  #shopify-section-{{ section.id }} .sv2s-card__price[data-sv2s-price] .sv2s-card__price-compare {
    order: 1;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save {
    order: 3;
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--rem));
    margin: 0;
    padding: calc(5 * var(--rem)) calc(8 * var(--rem));
    border: none;
    border-radius: calc(6 * var(--rem));
    background: var(--sv2s-save-bg);
    color: var(--sv2s-save-text);
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: 1.2;
    cursor: pointer;
    width: max-content;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check {
    appearance: none;
    -webkit-appearance: none;
    width: calc(12 * var(--rem));
    height: calc(12 * var(--rem));
    margin: 0;
    border: 1px solid currentColor;
    border-radius: calc(2 * var(--rem));
    background: #ffffff;
    position: relative;
    flex-shrink: 0;
    color: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check:checked {
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .sv2s-card__save-check:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: calc(3 * var(--rem));
    height: calc(6 * var(--rem));
    border: solid var(--sv2s-save-bg);
    border-width: 0 1.5px 1.5px 0;
    transform: translate(-50%, -55%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .sv2s-card__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(44 * var(--rem));
    margin-top: auto;
    padding: calc(10 * var(--rem)) calc(12 * var(--rem));
    border: none;
    border-radius: calc(6 * var(--rem));
    background: {{ section.settings.atc_bg | default: '#111111' }};
    color: {{ section.settings.atc_text_color | default: '#ffffff' }};
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s-card__atc:hover {
    background: var(--sv2s-accent);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-card__form {
    display: contents;
  }

  /* ===== Compare banner ===== */
  #shopify-section-{{ section.id }} .sv2s-compare {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: calc(24 * var(--rem));
    align-items: center;
    padding: calc(36 * var(--rem)) calc(40 * var(--rem));
    margin-bottom: 0;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: calc(8 * var(--rem));
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__title {
    margin: 0 0 calc(10 * var(--rem));
    font-family: var(--sv2s-heading-font);
    font-size: calc(36 * var(--rem));
    font-weight: 400;
    font-style: normal;
    line-height: 1.15;
    text-transform: uppercase;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__text {
    margin: 0 0 calc(18 * var(--rem));
    font-size: calc(16 * var(--rem));
    color: #555555;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(46 * var(--rem));
    padding: calc(12 * var(--rem)) calc(22 * var(--rem));
    background: var(--sv2s-accent);
    color: #ffffff;
    font-size: calc(13 * var(--rem));
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: calc(6 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .sv2s-compare__media .sv2s-compare__img--mobile {
    display: none;
  }

  /* ===== Feature (image left / text right) — full bleed ===== */
  #shopify-section-{{ section.id }} .sv2s-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: center;
    width: 100%;
    margin: 0;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__media {
    margin: calc(20 * var(--rem)) 0;
    margin-left: 0;
    border-radius: 0 calc(8 * var(--rem)) calc(8 * var(--rem)) 0;
    overflow: hidden;
    background: #ffffff;
    align-self: center;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__media .sv2s-feature__img {
    width: 100%;
    height: 100%;
    min-height: calc(380 * var(--rem));
    display: block;
    object-fit: cover;
    border-radius: 0 calc(8 * var(--rem)) calc(8 * var(--rem)) 0;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__media .sv2s-feature__img--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: calc(120 * var(--rem));
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__title {
    margin: 0 0 calc(20 * var(--rem));
    font-family: var(--sv2s-heading-font);
    font-size: calc(36 * var(--rem));
    font-weight: 400;
    font-style: normal;
    line-height: 1.15;
    text-transform: uppercase;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__list {
    display: flex;
    flex-direction: column;
    gap: calc(18 * var(--rem));
    margin: 0 0 calc(20 * var(--rem));
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__item {
    display: grid;
    grid-template-columns: calc(68 * var(--rem)) 1fr;
    gap: calc(18 * var(--rem));
    align-items: start;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__item-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(68 * var(--rem));
    height: calc(68 * var(--rem));
    border-radius: 50%;
    background:rgb(245, 245, 245);
    flex-shrink: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__item-icon {
    width: calc(26 * var(--rem));
    height: calc(26 * var(--rem));
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__item-title {
    margin: 0 0;
    font-size: calc(16 * var(--rem));
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__item-text {
    margin: 0;
    font-size: calc(14 * var(--rem));
    color: #666666;
    line-height: 1.45;
    width: calc(300 * var(--rem));
  }

  #shopify-section-{{ section.id }} .sv2s-feature__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 0;
    background: transparent;
    color: #111111;
    font-size: calc(14 * var(--rem));
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: none;
    border-radius: 0;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sv2s-feature__link:hover {
    color: var(--sv2s-accent);
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sv2s__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .sv2s-compare {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .sv2s-feature {
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .sv2s-feature__media {
      margin: calc(16 * var(--rem)) 0;
      border-radius: 0 calc(8 * var(--rem)) calc(8 * var(--rem)) 0;
    }

    #shopify-section-{{ section.id }} .sv2s-feature__media .sv2s-feature__img {
      min-height: calc(280 * var(--rem));
      border-radius: 0 calc(8 * var(--rem)) calc(8 * var(--rem)) 0;
    }

    #shopify-section-{{ section.id }} .sv2s-feature__content {
      padding: calc(24 * var(--rem)) calc(20 * var(--rem)) calc(24 * var(--rem)) calc(24 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
