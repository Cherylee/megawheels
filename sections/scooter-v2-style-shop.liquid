    #shopify-section-{{ section.id }} .sv2s-compare__title,
    #shopify-section-{{ section.id }} .sv2s-feature__title {
      font-size: calc(38 * var(--rem));
      margin-bottom: 0;
    }
    #shopify-section-template--17936600137936__scooter_v2_style_shop .sv2s-compare__text{
      margin-bottom: 0;
    }
