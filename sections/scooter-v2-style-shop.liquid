</style>

<div class="sv2s" data-sv2s-root>
  <div class="sv2s__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sv2s__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- assign tab_index = 0 -%}
    <div class="sv2s__tabs" role="tablist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          {%- liquid
            assign tab_key = block.settings.tab_key | strip | handleize
            if tab_key == blank
              assign tab_key = block.settings.title | handleize
            endif
            if tab_key == blank
              assign tab_key = 'tab-' | append: forloop.index
            endif
            assign tab_index = tab_index | plus: 1
          -%}
          <button
            type="button"
            class="sv2s__tab{% if tab_index == 1 %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
            data-sv2s-tab
            data-target="{{ tab_key | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon
                | image_url: width: 96
                | image_tag: class: 'sv2s__tab-icon', widths: '48,96', sizes: '36px', loading: 'lazy', alt: ''
              }}
            {%- endif -%}
            <p class="sv2s__tab-title">{{ block.settings.title | default: 'Category' | escape }}</p>
            {%- if block.settings.subtitle != blank -%}
              <p class="sv2s__tab-sub">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- assign panel_index = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tab' -%}
      {%- liquid
        assign tab_key = block.settings.tab_key | strip | handleize
        if tab_key == blank
          assign tab_key = block.settings.title | handleize
        endif
        if tab_key == blank
          assign tab_key = 'tab-' | append: forloop.index
        endif
        assign panel_index = panel_index | plus: 1
      -%}
      <div
        class="sv2s__panel{% if panel_index == 1 %} is-active{% endif %}"
        role="tabpanel"
        data-sv2s-panel
        data-key="{{ tab_key | escape }}"
      >
        <div class="sv2s__panel-main">
          <div class="sv2s__inner">
            {%- comment -%} Products {%- endcomment -%}
            <div class="sv2s__products-head">
              <h3 class="sv2s__products-title">{{ block.settings.products_heading | default: 'BEST SELLERS' | escape }}</h3>
              {%- if block.settings.view_all_text != blank -%}
                <a class="sv2s__view-all" href="{{ block.settings.view_all_link | default: '#' }}">
                  {{ block.settings.view_all_text | escape }}
                </a>
              {%- endif -%}
            </div>

            <div class="sv2s__grid">
            {%- assign panel_product_count = 0 -%}
            {%- for product_block in section.blocks -%}
              {%- if product_block.type == 'product_card' -%}
                {%- assign product_tab = product_block.settings.tab_key | strip | handleize -%}
                {%- if product_tab == tab_key -%}
                  {%- assign panel_product_count = panel_product_count | plus: 1 -%}
                  {%- liquid
                    assign product = product_block.settings.product
                    assign variant = product.selected_or_first_available_variant
                    assign display_title = product_block.settings.title
                    if display_title == blank and product != blank
                      assign display_title = product.title
                    endif
                    assign card_image = product_block.settings.image
                    if card_image == blank and product != blank
                      assign card_image = product.featured_media
                    endif
                    assign product_url = '#'
                    if product != blank
                      assign product_url = product.url
                    endif

                    assign price_original_label = product_block.settings.original_price | strip
                    assign price_sale_label = product_block.settings.sale_price | strip
                    assign save_amount_label = product_block.settings.save_amount | strip

                    if price_original_label == blank and product != blank
                      assign price_original_label = product.price | money | strip_html
                    endif
                    if price_sale_label == blank and product != blank and save_amount_label != blank
                      assign save_cents_tmp = save_amount_label | replace: '$', '' | replace: ',', '' | times: 100.0 | round
                      assign price_sale_cents = product.price | minus: save_cents_tmp
                      if price_sale_cents < 0
                        assign price_sale_cents = 0
                      endif
                      assign price_sale_label = price_sale_cents | money | strip_html
                    endif
                    if save_amount_label != blank
                      unless save_amount_label contains '$'
                        assign save_amount_label = save_amount_label | prepend: '$'
                      endunless
                    endif

                    assign form_id = 'sv2s-atc-' | append: section.id | append: '-' | append: product_block.id
                    assign card_save_bg = product_block.settings.save_btn_bg | default: section.settings.save_btn_bg | default: '#FFCC00'
                    assign card_save_text = product_block.settings.save_btn_text | default: section.settings.save_btn_text | default: '#000000'
                    assign card_sale_color = product_block.settings.sale_price_color | default: section.settings.sale_price_color | default: '#E53935'
                  -%}
                  {%- assign corner_tag = product_block.settings.corner_tag | strip -%}
                  <article class="sv2s-card" {{ product_block.shopify_attributes }}>
                    <a class="sv2s-card__media" href="{{ product_url }}">
                      {%- if product_block.settings.badge_text != blank -%}
                        <span class="sv2s-card__badge">
                          {%- assign badge_lines = product_block.settings.badge_text | newline_to_br | split: '<br />' -%}
                          {%- if badge_lines.size == 1 -%}
                            {%- assign badge_lines = product_block.settings.badge_text | newline_to_br | split: '<br>' -%}
                          {%- endif -%}
                          {%- for line in badge_lines -%}
                            {%- assign line_text = line | strip -%}
                            {%- if line_text != blank -%}
                              <span class="sv2s-card__badge-line">{{ line_text | escape }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                        </span>
                      {%- endif -%}
                      {%- if corner_tag != blank -%}
                        <span class="sv2s-card__tag sv2s-card__tag--media">{{ corner_tag | escape }}</span>
                      {%- endif -%}
                      {%- if card_image != blank -%}
                        {{ card_image
                          | image_url: width: 800
                          | image_tag:
                            widths: '300,400,600,800',
                            sizes: '(max-width: 749px) 30vw, 25vw',
                            loading: 'lazy',
                            alt: display_title
                        }}
                      {%- endif -%}
                    </a>

                    <div class="sv2s-card__body">
                      <div class="sv2s-card__head">
                        {%- if display_title != blank -%}
                          <h4 class="sv2s-card__title">
                            <a href="{{ product_url }}">{{ display_title | escape }}</a>
                          </h4>
                        {%- endif -%}
                        {%- if corner_tag != blank -%}
                          <span class="sv2s-card__tag sv2s-card__tag--inline">{{ corner_tag | escape }}</span>
                        {%- endif -%}
                      </div>

                      {%- liquid
                        assign rating_raw = product_block.settings.rating | strip
                        if rating_raw == blank
                          assign rating_raw = '5'
                        endif
                        assign rating_num = rating_raw | times: 1.0
                        if rating_num < 1
                          assign rating_num = 1.0
                        endif
                        if rating_num > 5
                          assign rating_num = 5.0
                        endif
                        assign show_rating = false
                        if product_block.settings.rating != blank or product_block.settings.rating_count != blank
                          assign show_rating = true
                        endif
                      -%}
                      {%- if show_rating -%}
                        <div class="sv2s-card__rating">
                          <span class="sv2s-card__stars" aria-label="{{ rating_num }} out of 5 stars">
                            {%- for i in (1..5) -%}
                              {%- assign star_index = i -%}
                              {%- assign star_prev = i | minus: 1 -%}
                              {%- if rating_num >= star_index -%}
                                <svg class="sv2s-card__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                  <path
                                    fill="currentColor"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round"
                                    stroke-linecap="round"
                                    d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                                  />
                                </svg>
                              {%- elsif rating_num > star_prev -%}
                                {%- assign fill_frac = rating_num | minus: star_prev -%}
                                {%- assign fill_pct = fill_frac | times: 100 -%}
                                <span class="sv2s-card__star--partial" style="--sv2s-star-fill: {{ fill_pct }}%;">
                                  <svg class="sv2s-card__star sv2s-card__star--empty" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linejoin="round"
                                      stroke-linecap="round"
                                      d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                                    />
                                  </svg>
                                  <span class="sv2s-card__star-fill">
                                    <svg class="sv2s-card__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                      <path
                                        fill="currentColor"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linejoin="round"
                                        stroke-linecap="round"
                                        d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                                      />
                                    </svg>
                                  </span>
                                </span>
                              {%- else -%}
                                <svg class="sv2s-card__star sv2s-card__star--empty" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                  <path
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round"
                                    stroke-linecap="round"
                                    d="M12 3.1l2.55 5.55 6.05.55-4.55 4.15 1.35 5.95L12 16.55 6.6 19.3l1.35-5.95-4.55-4.15 6.05-.55L12 3.1z"
                                  />
                                </svg>
                              {%- endif -%}
                            {%- endfor -%}
                          </span>
                          {%- if product_block.settings.rating_count != blank -%}
                            <span>({{ product_block.settings.rating_count | escape }})</span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      {%- if product_block.settings.spec_range != blank or product_block.settings.spec_speed != blank or product_block.settings.spec_motor != blank -%}
                        <div class="sv2s-card__specs">
                          <div class="sv2s-card__spec">
                            {%- if product_block.settings.spec_range_icon != blank -%}
                              {{ product_block.settings.spec_range_icon | image_url: width: 64 | image_tag: class: 'sv2s-card__spec-icon', widths: '32,64', sizes: '22px', loading: 'lazy', alt: '' }}
                            {%- endif -%}
                            <div class="sv2s-card__spec-text">
                              <span class="sv2s-card__spec-value">{{ product_block.settings.spec_range | default: '—' | escape }}</span>
                              <span class="sv2s-card__spec-label">{{ product_block.settings.spec_range_label | default: 'Range' | escape }}</span>
                            </div>
                          </div>
                          <div class="sv2s-card__spec">
                            {%- if product_block.settings.spec_speed_icon != blank -%}
                              {{ product_block.settings.spec_speed_icon | image_url: width: 64 | image_tag: class: 'sv2s-card__spec-icon', widths: '32,64', sizes: '22px', loading: 'lazy', alt: '' }}
                            {%- endif -%}
                            <div class="sv2s-card__spec-text">
